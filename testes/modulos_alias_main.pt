funcao falhar(mensagem) {
    escreva("FALHA_MOD_ALIAS:", mensagem)
    funcao_que_nao_existe()
}

usar "modulos_alias/lib.pt" como util
usar "./modulos_alias/../modulos_alias/lib.pt" como outra

se util.dobro(5) != 10 {
    falhar("funcao exportada pelo alias")
}

se outra.dobro(6) != 12 {
    falhar("segundo alias do mesmo modulo")
}

se util.versao_modulo != "3.7" {
    falhar("valor exportado pelo alias")
}

var caixa = novo util.Caixa(7)
se tipo(caixa) != "Caixa" {
    falhar("classe qualificada pelo alias")
}
se caixa.valor != 7 ou caixa.dobro() != 14 {
    falhar("construtor/metodo com estado privado do modulo")
}

escreva("MOD_ALIAS_OK")
