/* Regressão do núcleo canônico do Leviata 3. */

funcao falhar(mensagem) {
    escreva("FALHA:", mensagem)
    funcao_que_nao_existe()
}

var chamadas = 0

funcao marcar(valor) {
    chamadas = chamadas + 1
    retorne valor
}

/* Short-circuit. */
var curto_e = falso e marcar(verdadeiro)
var curto_ou = verdadeiro ou marcar(falso)

se chamadas != 0 {
    falhar("short-circuit executou o lado direito")
}
se curto_e != falso { falhar("falso e X") }
se curto_ou != verdadeiro { falhar("verdadeiro ou X") }

var avalia_e = verdadeiro e marcar(verdadeiro)
var avalia_ou = falso ou marcar(verdadeiro)
se chamadas != 2 { falhar("lado direito necessario") }
se avalia_e != verdadeiro { falhar("verdadeiro e verdadeiro") }
se avalia_ou != verdadeiro { falhar("falso ou verdadeiro") }

/* Escopos locais. */
funcao testar_escopos() {
    var total = 0
    var n = 0

    enquanto n < 3 {
        var temporario = n + 1
        total = total + temporario
        n = n + 1
    }

    se total == 6 {
        var interno = 4
        total = total + interno
    }

    retorne total
}

se testar_escopos() != 10 {
    falhar("escopos locais em blocos/loops")
}

/* Shadowing. */
var externo = 10
se verdadeiro {
    var externo = 20
    se externo != 20 { falhar("shadowing local") }
}
se externo != 10 { falhar("shadowing alterou global") }

/* Lista, índices e para-em. */
var dados = [10, 20, 30]
se dados[0] != 10 ou dados[1] != 20 ou dados[2] != 30 {
    falhar("ordem da lista")
}

se dados[1.0] != 20 { falhar("indice 1.0") }
dados[1.0] = 99
se dados[1] != 99 { falhar("escrita indice 1.0") }

dados[0] += 5
se dados[0] != 15 { falhar("atribuicao composta") }

var soma_lista = 0
para valor em dados {
    soma_lista = soma_lista + valor
}
se soma_lista != 144 { falhar("para item em lista") }

/* pare e continue precisam limpar os escopos corretamente. */
var soma_laco = 0
para n de 1 ate 10 {
    var local = n
    se n == 3 { continue }
    se n == 6 { pare }
    soma_laco = soma_laco + local
}
se soma_laco != 12 { falhar("pare/continue") }

/* API base canônica. */
var lista_teste = lista()
adicionar(lista_teste, "a")
adicionar(lista_teste, "b")
inserir(lista_teste, 1, "x")
se tamanho(lista_teste) != 3 { falhar("inserir") }
se nao contem(lista_teste, "x") { falhar("contem lista") }
remover(lista_teste, "x")
se contem(lista_teste, "x") { falhar("remover") }

se int("42") != 42 { falhar("int") }
se dec("3.5") != 3.5 { falhar("dec") }
se txt(42) != "42" { falhar("txt") }
se bool(1) != verdadeiro { falhar("bool") }
se tipo("oi") != "txt" { falhar("tipo") }

escreva("NUCLEO_OK")
