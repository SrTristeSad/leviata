/* Biblioteca para regressão de exportar/alias e isolamento do Leviata 3.7. */

exportar const versao_modulo = "3.7"

var fator_privado = 2
var secreto = 999

exportar funcao dobro(valor) {
    /* A função exportada precisa continuar enxergando um global privado. */
    retorne valor * fator_privado
}

exportar classe Caixa {
    var valor = 0

    funcao iniciar(valor) {
        este.valor = valor
    }

    funcao dobro() {
        retorne este.valor * fator_privado
    }
}
