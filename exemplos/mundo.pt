/* Leviata 3 - entidades, física, mapa externo e câmera */

var mundo = mapa.carregar("exemplos/mapas/mundo.csv")
var largura = mapa.largura()
var altura = mapa.altura()
var tile = 32

escreva("Mapa carregado:", largura, "x", altura)

jogo.iniciar("Leviata World 3", 960, 540, 60)
camera.configurar(160, 120, 1, 0)
camera.limites(0, 0, largura * tile, altura * tile)

var jogador = entidade.criar("jogador", 96, 80, 26, 30)
entidade.fisica(jogador, 980, 5)
entidade.colisor(jogador, verdadeiro)

cena.mudar("mundo")
escreva("Entidades ativas:", entidade.quantidade())

var dt = 0
var vx = 0
var vy = 0
var px = 0
var py = 0

enquanto nao jogo.deve_fechar() {
    dt = jogo.delta()
    vx = 0

    se teclado.pressionada("A") { vx = -180 }
    se teclado.pressionada("D") { vx = 180 }

    vy = entidade.vy(jogador)
    se teclado.apertada("espaco") e entidade.no_chao(jogador) {
        vy = -430
    }

    entidade.velocidade(jogador, vx, vy)
    entidade.atualizar_mapa(jogador, dt, mundo, largura, tile, tile, 0, 0)

    px = entidade.x(jogador)
    py = entidade.y(jogador)
    camera.seguir(px + 13, py + 15)

    jogo.quadro()
    desenho.fundo(18, 22, 32)
    camera.iniciar()

    desenho.retangulo(0, 288, 640, 32, 65, 76, 95)
    desenho.retangulo(384, 96, 96, 32, 65, 76, 95)
    desenho.retangulo(384, 128, 32, 96, 65, 76, 95)
    desenho.retangulo(448, 128, 32, 96, 65, 76, 95)
    desenho.retangulo(384, 224, 96, 32, 65, 76, 95)

    entidade.desenhar(jogador, 80, 190, 255)
    camera.finalizar()

    desenho.texto("A/D move | Espaco pula | mapa externo + fisica", 22, 22, 22, 235, 240, 250)
    desenho.texto("Cena: " + cena.atual(), 22, 50, 18, 180, 190, 210)
    jogo.mostrar()
}

jogo.fechar()
