/* Matemática no Leviata 3 */
escreva("=== MATEMÁTICA ===")

escreva("Raiz de 16:", raiz(16))
escreva("2^8:", potencia(2, 8))
escreva("Pi:", pi)
escreva("Seno(0):", seno(0))
escreva("Cos(0):", cos(0))
escreva("Abs(-7):", abs(-7))
escreva("Arredondar(3.7):", arredondar(3.7))
escreva("Máximo(5, 9):", max(5, 9))
escreva("Mínimo(5, 9):", min(5, 9))
escreva("Aleatório inteiro 1-100:", aleatorio_int(1, 100))
