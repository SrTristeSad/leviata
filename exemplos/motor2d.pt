/* Motor 2D no Leviata 3 */

jogo.iniciar("Leviata Motor 2D", 960, 540, 60)
cena.mudar("jogo")

var jogador_x = 100
var jogador_y = 100
var jogador_w = 48
var jogador_h = 48
var parede_x = 360
var parede_y = 120
var parede_w = 90
var parede_h = 260
var velocidade = 220

camera.configurar(jogador_x, jogador_y, 1, 0, 480, 270)

enquanto nao jogo.deve_fechar() {
    var dt = jogo.delta()
    var novo_x = jogador_x
    var novo_y = jogador_y

    se teclado.pressionada("A") { novo_x = novo_x - velocidade * dt }
    se teclado.pressionada("D") { novo_x = novo_x + velocidade * dt }
    se teclado.pressionada("W") { novo_y = novo_y - velocidade * dt }
    se teclado.pressionada("S") { novo_y = novo_y + velocidade * dt }

    se nao colisao.retangulos(novo_x, jogador_y, jogador_w, jogador_h,
                              parede_x, parede_y, parede_w, parede_h) {
        jogador_x = novo_x
    }

    se nao colisao.retangulos(jogador_x, novo_y, jogador_w, jogador_h,
                              parede_x, parede_y, parede_w, parede_h) {
        jogador_y = novo_y
    }

    camera.seguir(jogador_x + jogador_w / 2, jogador_y + jogador_h / 2)

    jogo.quadro()
    desenho.fundo(18, 21, 30)

    camera.iniciar()
    desenho.retangulo(-500, -500, 2000, 2000, 28, 36, 48)
    desenho.retangulo(parede_x, parede_y, parede_w, parede_h, 210, 90, 90)
    desenho.retangulo(jogador_x, jogador_y, jogador_w, jogador_h, 80, 185, 255)
    camera.finalizar()

    desenho.texto("Leviata 3 - WASD", 24, 22, 26, 240, 240, 245)
    desenho.texto("Camera + colisao + cenas", 24, 55, 20, 180, 190, 205)

    jogo.mostrar()
}

escreva("Cena atual:", cena.atual())
escreva("Teste AABB:", colisao.retangulos(0, 0, 10, 10, 5, 5, 10, 10))
jogo.fechar()
