/* Exemplo Raylib com a API canônica do Leviata 3 */

jogo.iniciar("Leviata + Raylib", 960, 540, 60)

var x = 430
var y = 240
var velocidade = 240

enquanto nao jogo.deve_fechar() {
    var dt = jogo.delta()

    se teclado.pressionada("A") { x = x - velocidade * dt }
    se teclado.pressionada("D") { x = x + velocidade * dt }
    se teclado.pressionada("W") { y = y - velocidade * dt }
    se teclado.pressionada("S") { y = y + velocidade * dt }

    jogo.quadro()
    desenho.fundo(20, 24, 36)

    desenho.texto("Leviata rodando com Raylib", 30, 30, 28, 235, 235, 245)
    desenho.texto("Use W A S D para mover", 30, 70, 20, 180, 190, 210)
    desenho.retangulo(x, y, 70, 70, 90, 180, 255)
    desenho.circulo(mouse.x(), mouse.y(), 8, 255, 190, 80)

    jogo.mostrar()
}

jogo.fechar()
