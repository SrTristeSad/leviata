/* Leviata 3 - entidade, NPC, gatilho e câmera suave */

jogo.iniciar("Leviata Gameplay 3", 960, 540, 60)

var jogador = entidade.criar("jogador", 100, 220, 32, 48)
var npc = entidade.criar("guarda", 430, 220, 36, 48)
var zona = entidade.criar("zona_da_porta", 380, 180, 140, 120)

entidade.gatilho(zona, verdadeiro)
entidade.colisor(npc, verdadeiro)

camera.configurar(100, 220, 1, 0)
camera.suavidade(7)
camera.limites(0, 0, 1600, 900)

var mensagem = "Chegue perto do guarda"

enquanto nao jogo.deve_fechar() {
    var dt = jogo.delta()
    var vx = 0

    se teclado.pressionada("A") { vx = -220 }
    se teclado.pressionada("D") { vx = 220 }

    entidade.velocidade(jogador, vx, 0)
    entidade.atualizar(jogador, dt)

    se entidade.colide(jogador, zona) {
        mensagem = "Voce entrou na zona do guarda"
    } senao {
        mensagem = "Chegue perto do guarda"
    }

    var px = entidade.x(jogador)
    var py = entidade.y(jogador)
    camera.seguir(px + 16, py + 24)

    jogo.quadro()
    desenho.fundo(18, 22, 32)

    camera.iniciar()
    desenho.retangulo(0, 268, 1600, 40, 60, 72, 86)
    desenho.retangulo(380, 180, 140, 120, 45, 80, 100, 80)
    entidade.desenhar(jogador, 80, 190, 255)
    entidade.desenhar(npc, 240, 180, 70)
    camera.finalizar()

    desenho.texto("A/D move", 22, 22, 22, 235, 240, 250)
    desenho.texto(mensagem, 22, 52, 20, 190, 210, 235)
    jogo.mostrar()
}

jogo.fechar()
