/* Listas no Leviata 3 */
escreva("=== LISTAS ===")

var frutas = ["maçã", "banana", "laranja"]
escreva("Frutas:", tamanho(frutas), "itens")
escreva("Primeira:", frutas[0])

adicionar(frutas, "uva")
escreva("Após adicionar uva:", tamanho(frutas))

/* Percorrer coleção sem índice manual. */
para fruta em frutas {
    escreva("-", fruta)
}

var numeros = [10, 20, 30, 40, 50]
var soma = 0
para numero em numeros {
    soma = soma + numero
}

escreva("Soma dos números:", soma)
escreva("Contém banana:", contem(frutas, "banana"))
